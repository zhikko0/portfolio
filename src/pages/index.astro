---
import Badge from '../components/Badge.astro';
import Layout from '../layouts/Layout.astro';
import Social from '../components/Social.astro';
import Experiencie from '../components/Experiencie.astro';
import SectionContainer from '../components/SectionContainer.astro'
import Proyectos from '../components/Proyectos.astro'

import Linkedin from '../components/icons/LinkedIn.astro'
import GitHub from '../components/icons/GitHub.astro';
import CV from '../components/icons/CV.astro'
import Mail from '../components/icons/Mail.astro';
import Briefcase from '../components/icons/Briefcase.astro';
import Code from '../components/icons/Code.astro'
import AboutMe from '../components/AboutMe.astro';
import Me from '../components/icons/Me.astro'

---

<Layout 
title="Portafolio Sebastian -  Desarrollador y Programador Web "
description="Desarrollador Frontend">
	<main class="px-4">
		<SectionContainer class="py-40 pb-25">
			<div class="flex gap-4 mb-4">
				<img class="rounded-full w-12 h-12 mb-4" src="../public/dev.jpg" alt="Foto del desarrollador"/>
				<a href="https://www.linkedin.com/in/sebastianvaldesescobar" target="_blank" rel="noopener" class="flex justify-center items-center"> <Badge>Buscando practicas</Badge> </a>
			</div>

			<h1 class="text-white text-3xl  md:text-4xl lg:text-5xl font-bold flex flex-row gap-x-4 pb-6 lg:pb-10">
				Hey, soy Sebastián 
			</h1>
			<h2 class="text-xl lg:text-2xl text-wrap max-w-[700px]">
				<span class="text-yellow-300 ">Desarrollador frontend</span> que construye interfaces modernas y eficientes. Pensadas para funcionar bien sin hacer demasiado ruido. Convierto ideas en experiencias webs limpias y fluidas.
			</h2>

			<nav class="flex gap-x-4 mt-8 flex-wrap">
				<Social href="http://www.linkedin.com/in/sebastianvaldesescobar">
					<Linkedin class=" size-4 md:size-6"/>LinkedIn
				</Social>
				<Social href="https://github.com/zhikko0">
					<GitHub class=" size-4 md:size-6"/>GitHub
				</Social>
				<Social href="#">
					<CV class=" size-4 md:size-6"/>Descargar CV
				</Social>
				<Social href="mailto:sebastian.valdesescobar@gmail.com">
					<Mail class=" size-4 md:size-6"/>Enviar correo
				</Social>
			</nav>	
		</SectionContainer>

		<SectionContainer id="experiencia">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<Briefcase class="size-7"/>
				Experiencia laboral
			</h2>
			<Experiencie/>
		</SectionContainer>

		<SectionContainer id="proyectos">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<Code class="size-7"/>
				Proyectos
			</h2>
			<Proyectos/>
		</SectionContainer>
		<SectionContainer id="sobre-mi">
			<h2 class="text-3xl font-semibold mb-6  items-center">
				<Me class="size-7"/>
				Sobre mi
				<AboutMe/>
			</h2>
		</SectionContainer>
	</main>
</Layout>
