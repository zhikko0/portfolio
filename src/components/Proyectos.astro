---
import HTML from "./icons/HTML.astro"
import NextJS from "./icons/NextJS.astro";
import Tailwind from "./icons/Tailwind.astro"

const TAGS = {
  HTML:{
    name: "HTML",
    class: "bg-black text-white",
    icon: HTML,
  },
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },

  
};

const proyectos = [
  {
    title: "Lorem Ipsum",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus vulputate nibh quis est lobortis, at auctor nunc viverra. Duis at elit ac purus rutrum auctor.",
    link: "#",
    github: "#",
    image: "../public/dev.jpg",
    tags: [TAGS.NEXT, TAGS.HTML, TAGS.TAILWIND],
  },
];
---

{
  proyectos.map(({ title, description, link, github, image, tags }) => (
    <article>
      <h3 class="text-2xl font-semibold mb-2">{title}</h3>
      <p class="text-lg mb-4 text-pretty">{description}</p>
      <ul class="flex gap-x-4 flex-row mb-2">
        {tags.map((tag) => (
          <li>
            <span class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}>
              <tag.icon class="size-4"/>
              {tag.name}
            </span>
          </li>
        ))}
      </ul>
      <img
        src={image}
        class="h-[200px] rounded"
        alt={`Captura de imagen del proyecto ${image}`}
      />
    </article>
  ))
}
